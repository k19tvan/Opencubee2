
# LLM & Search Configuration
GROQ_API_KEY="your_groq_api_key"
TAVILY_API_KEY="your_tavily_api_key"


# Meilisearch Configuration

MEILISEARCH_HOST="http://localhost:7700"
OCR_ASR_INDEX_NAME="ocr_only_beit3_096"


# Qdrant Configuration

QDRANT_HOST="localhost"
QDRANT_COLLECTION_BGE="bge"
QDRANT_COLLECTION_BEIT3="beit3"
QDRANT_COLLECTION_METACLIP2="metaclip2"
QDRANT_COLLECTION_JINA_V5_OMNI="jina_v5_omni"


# Embedding Worker URLs

BGE_WORKER_URL="http://127.0.0.1:2001/embed"
BEIT3_WORKER_URL="http://127.0.0.1:2002/embed"
METACLIP2_WORKER_URL="http://127.0.0.1:2003/embed"
JINA_V5_OMNI_WORKER_URL="http://127.0.0.1:2004/embed"

# FG-CLIP 2
QDRANT_COLLECTION_FGCLIP2="fgclip2"
FGCLIP2_WORKER_URL="http://127.0.0.1:2005/embed"
FGCLIP2_PORT=2005
FGCLIP2_DEVICE="cuda:0"
FGCLIP2_MODEL_PATH="/workingspace_aiclub/WorkingSpace/Personal/nguyenmv/Opencubee2_HCMAI25/Opencubee2/models/fg-clip2-large"
FGCLIP2_MODEL_REVISION="4d1d5dc35c716902f07c172dbfc23b82a7bc6bf3"
FGCLIP2_LOCAL_FILES_ONLY=true
FGCLIP2_TEXT_MAX_LENGTH=64
FGCLIP2_TEXT_WALK_TYPE="short"
FGCLIP2_KEYFRAME_DIR="/workingspace_aiclub/WorkingSpace/Personal/nguyenmv/Opencubee2_HCMAI25/results/keyframes/beit3_096"
# Mount a persistent Docker volume at this path before full embedding.
FGCLIP2_STATE_DIR="/root/fgclip2-state"


# Translation Configuration
TRANSLATE_PROVIDER="google_translate"

TEXT_PROCESSING_TIMEOUT_SECONDS=5
TEXT_PROCESSING_CACHE_TTL_SECONDS=900
TEXT_PROCESSING_CACHE_MAX_SIZE=512
TEXT_PROCESSING_MAX_CONCURRENCY=3

# Agent / vision critic (OpenAI-compatible Qwen endpoint)
AGENT_MODEL="qwen35_9b"
AGENT_MODEL_BASE_URL="http://192.168.20.150:2308/v1"
AGENT_MODEL_API_KEY="None"

# Gemini browser research pool. Each path is an independent Chromium profile.
GEMINI_SESSION_POOL_SIZE=5
GEMINI_SESSION_ROOT="./backend/api/gemini_sessions"
GEMINI_HEADLESS=true
GEMINI_TIMEOUT_SECONDS=90
# Optional: comma-separated pre-authenticated profiles; overrides ROOT/POOL_SIZE.
# GEMINI_SESSION_DIRS="/profiles/gemini-1,/profiles/gemini-2,/profiles/gemini-3,/profiles/gemini-4,/profiles/gemini-5"
