# LLM and Google Search configuration
GROQ_API_KEY="Your GROQ_API_KEY here"
TAVILY_API_KEY="Your TAVILY_API_KEY here"

# Translation provider for literal query translation:
# - llm_translate: use backend runtime.llm_translate
# - google_translate: use googletrans + langdetect
TRANSLATE_PROVIDER="google_translate"

# Meilisearch configuration
MEILISEARCH_HOST="Your Meilisearch host URL here"
OCR_ASR_INDEX_NAME='Your OCR/ASR index name here'

# Qdrant configuration
QDRANT_HOST="Your Qdrant host URL here"
QDRANT_COLLECTION_BGE='Your Qdrant collection name for BGE here'
QDRANT_COLLECTION_BEIT3='Your Qdrant collection name for BEIT3 here'
QDRANT_COLLECTION_METACLIP2='Your Qdrant collection name for METACLIP2 here'
QDRANT_COLLECTION_JINA_V5_OMNI='Your Qdrant collection name for JINA_V5_OMNI here'

# Embedding worker url
BGE_WORKER_URL="Your BGE worker URL here"
BEIT3_WORKER_URL="Your BEIT3 worker URL here"
JINA_V5_OMNI_WORKER_URL="Your JINA_V5_OMNI worker URL here"
METACLIP2_WORKER_URL="Your METACLIP2 worker URL here"
